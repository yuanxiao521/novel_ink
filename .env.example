# ============================================================
# 墨卷 · 涌现式小说 Agent —— 环境变量模板
# 用法：复制为仓库根目录的 .env（backend/app/config.py 的 env_file 指向根目录 .env）
#   copy .env.example .env      # Windows
#   cp .env.example .env        # macOS / Linux
# 说明：
#   - 变量统一前缀 NOVEL_（pydantic-settings 的 env_prefix）
#   - 未配置的项回落 backend/app/config.py 的默认值
#   - .env 已被 .gitignore 忽略（*.env / .env.*），真实密钥不要提交
#   - .env.example 由 .gitignore 的 !.env.example 例外规则保留在版本库中
# ============================================================

# ---------- 数据库（PostgreSQL 16 + pgvector） ----------
# 与 docker-compose.yml 的 POSTGRES_* 保持一致；容器端口映射到宿主机 5433
NOVEL_DB_USER=postgres
NOVEL_DB_PASSWORD=change-me-in-your-own-env
NOVEL_DB_NAME=novel
NOVEL_DB_HOST=localhost
NOVEL_DB_PORT=5433

# ---------- LLM（OpenAI 兼容协议） ----------
# 留空 = 自动走确定性回退，不配 key 也能跑通「涌现 + 护栏」闭环
# 下方示例为阿里云百炼；官方 DeepSeek 可改 https://api.deepseek.com/v1
NOVEL_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NOVEL_OPENAI_API_KEY=
# 强模型 = 角色演绎；廉模型 = 导演 / 成文 / 主笔 / 评估器
NOVEL_MODEL_STRONG=deepseek-v4-flash
NOVEL_MODEL_CHEAP=deepseek-v4-flash

# ---------- 涌现与护栏参数（可选，注释掉即用 config.py 默认值） ----------
NOVEL_MAX_TURNS=60
NOVEL_GUARD_RETRY_MAX=2
# NOVEL_HAND_RAISE_AUTO_PAUSE=false
# NOVEL_SCENARIO_NAME=betrayal_night
# 持久化开关：DB 未就绪时置 false，走内存态跑通闭环
NOVEL_PERSIST=true
# 回退模式确定性 seed（便于「同剧本多次运行对比」）
NOVEL_SEED=42
